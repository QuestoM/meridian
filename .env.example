# Kairos local environment. Copy this file to .env (same folder), fill in the
# real values, and restart the server. The .env file is gitignored and must
# never be committed; keep its permissions private (chmod 600 .env).

# The Anthropic API key that powers the in-product AI assistant. Either name
# works; ANTHROPIC_API_KEY is the standard one. Without a key the assistant
# reports itself unavailable honestly.
# ANTHROPIC_API_KEY=sk-ant-...
# KAIROS_ASSISTANT_API_KEY=

# Optional: override the assistant model (defaults to the newest Sonnet).
# KAIROS_ASSISTANT_MODEL=claude-sonnet-4-6

# Optional: seed password for the admin account on first start.
# KAIROS_ADMIN_PASSWORD=

# Development only: disable the login wall entirely. Never in production.
# KAIROS_AUTH_DISABLED=1
