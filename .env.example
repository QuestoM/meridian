# Kairos local environment. Copy this file to .env (same folder), fill in the
# real values, and restart the server. The .env file is gitignored and must
# never be committed; keep its permissions private (chmod 600 .env).

# In-product AI assistant credentials (Anthropic).
#
# Preferred on a developer Mac: Claude Max / Claude Code OAuth, the same login
# the local `claude` CLI uses (Keychain item "Claude Code-credentials", often
# switched with claude-switch). Default is ON; set to 0 to force API-key only.
# KAIROS_ASSISTANT_USE_CLAUDE_CODE_OAUTH=1
#
# Optional explicit Bearer token (same shape as Claude Code accessToken):
# ANTHROPIC_AUTH_TOKEN=
#
# Pay-as-you-go console API key fallback (NOT the Max subscription). Either name
# works. Without OAuth and without a key the assistant reports unavailable.
# ANTHROPIC_API_KEY=sk-ant-...
# KAIROS_ASSISTANT_API_KEY=

# Optional: override the assistant model (defaults to claude-opus-4-8).
# KAIROS_ASSISTANT_MODEL=claude-sonnet-4-6

# Optional: seed password for the admin account on first start.
# KAIROS_ADMIN_PASSWORD=

# Development only: disable the login wall entirely. Never in production.
# KAIROS_AUTH_DISABLED=1
