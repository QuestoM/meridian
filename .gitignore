.venv311/

# Runtime audit log written by the observability run logger
output/run_log.jsonl

# Runtime AI classification cache (regenerated by scripts/classify_unclassified.py)
models/ai_program_classifications.json

# Runtime API backups of advertiser CSVs
data/_backups/
output/*.meta.json

# Kairos login store (per-deployment credentials, never committed)
data/auth/

# Assistant action-plane runtime state (proposals, restore points, audit log)
data/assistant/

# System-wide activity log runtime state (append-only JSONL, metadata only)
data/audit/

# Operation-state version history (immutable snapshots of the mutable state files)
data/versions/

# Ad-hoc UI verification screenshots and browser-automation scratch output
/*.png
.playwright-mcp/
output/*.png
