.venv311/

# Runtime audit log written by the observability run logger
output/run_log.jsonl

# Runtime AI classification cache (regenerated by scripts/classify_unclassified.py)
models/ai_program_classifications.json

# Runtime API backups of advertiser CSVs
data/_backups/
output/*.meta.json

# Kairos login store (per-deployment credentials, never committed)
data/auth/

# Assistant action-plane runtime state (proposals, restore points, audit log)
data/assistant/

# System-wide activity log runtime state (append-only JSONL, metadata only)
data/audit/

# Operation-state version history (immutable snapshots of the mutable state files)
data/versions/

# Ad-hoc UI verification screenshots and browser-automation scratch output
/*.png
.playwright-mcp/
output/*.png
tv-break-dashboard/.probe-shell/

# Local reading aid built from docs/research (owner-only, never committed)
guide/

# Trade-agreement store: operator documents at runtime, and a reproducible
# corpus-derived dev fixture in development. scripts/seed_trade_agreements.py
# regenerates the fixture; real signed agreements must never enter git.
data/agreements/
data/trade_credit_ledger.csv

# The rival's schedule, pulled fresh by kairos.model.keshet_feed. Deliberately
# untracked: it is a licensed third party's data, it is rewritten every day, and
# nothing is lost by its absence — the competitor stack answers honestly that it
# has no schedule and contributes exactly zero until the next pull.
data/reference/CompetitorProgrammes.csv
data/reference/CompetitorProgrammes.freshness.json

# The daily feed's log, written by the launchd agent.
scripts/competitor-feed/feed.log
